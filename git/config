[include]
	path = ~/.config/git/identities/{{ git_default_identity }}.gitconfig
[alias]
	as-me = !sh "$HOME/.config/scripts/git-as-me"
	as-work = !sh "$HOME/.config/scripts/git-as-work"
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[core]
	editor = nvim +NoSession
	autocrlf = input
	eol = lf
	pager = less
	excludesfile = ~/.gitignore_global
[credential]
	credentialStore = gpg
[merge]
	conflictStyle = zdiff3
[pager]
	diff = true
[diff]
	external = difft
[init]
	defaultBranch = main

[credential "https://github.com"]
	helper = !/{{#if dotter.macos}}Users{{else}}home{{/if}}/{{username}}/.nix-profile/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper = !/{{#if dotter.macos}}Users{{else}}home{{/if}}/{{username}}/.nix-profile/bin/gh auth git-credential
